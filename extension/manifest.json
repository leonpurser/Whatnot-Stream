{
  "manifest_version": 3,
  "name": "Whatnot Show Control \u2013 Probe",
  "version": "0.2.0",
  "description": "Reads the visible Whatnot show page (read-only) and sends auction, sale and chat events to the local Show Control server.",
  "content_scripts": [
    {
      "matches": [
        "https://www.whatnot.com/*",
        "http://localhost/mock/*"
      ],
      "js": [
        "src/selectors.js",
        "src/parse.js",
        "src/tracker.js",
        "src/panel.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "host_permissions": [
    "http://127.0.0.1:3000/*"
  ]
}
